rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admin_sessions/current_admin) &&
             get(/databases/$(database)/documents/admin_sessions/current_admin).data.uid == request.auth.uid;
    }

    // Game document rules
    match /games/{gameId} {
      // Anyone can read the game state
      allow read: if true;
      // Only admins can write
      allow write: if isAdmin();
    }

    // Admin sessions
    match /admin_sessions/{docId} {
      // Anyone can read admin session (to check if someone is admin)
      allow read: if true;
      // Only the current user can write to admin session
      allow write: if request.auth != null && 
                  (
                    // Allow write if no admin exists
                    !exists(/databases/$(database)/documents/admin_sessions/current_admin) ||
                    // Or if this user is the current admin
                    get(/databases/$(database)/documents/admin_sessions/current_admin).data.uid == request.auth.uid
                  );
    }
  }
}