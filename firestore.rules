rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admin_sessions/$(request.auth.uid));
    }

    // Game document rules
    match /games/{gameId} {
      // Anyone can read the game state
      allow read: if true;
      // Only admins can write
      allow write: if isAdmin();
    }

    // Admin sessions (stores admin authentication state)
    match /admin_sessions/{uid} {
      // Allow creation and deletion of admin sessions
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}